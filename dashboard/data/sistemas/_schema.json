{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sistema de Progressao",
  "type": "object",
  "properties": {
    "system_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "related_items": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
