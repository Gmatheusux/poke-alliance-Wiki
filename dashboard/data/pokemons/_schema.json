{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pokemon",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "name": { "type": "string" },
    "generation": { "type": "integer" },
    "stats": {
      "type": "object",
      "properties": {
        "level_required": { "type": "integer" },
        "base_exp": { "type": "integer" }
      }
    },
    "moveset": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": { "type": "string", "description": "m1 to m12 or !autocombo" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "category": { "type": "string", "description": "[AOE], [BUFF], [SINGLE TARGET]" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ex: Fly, Surf, Ride, Hunt Locations"
    }
  }
}
